# ==============================================================================
# ieWebNative - Environment & Firebase Configuration
# ==============================================================================
# Copy this file to .env in the project root:
#   copy .env.example .env
#
# NOTE: The application features automatic dual-mode resilience:
# - If Firebase keys are NOT set, the app runs 100% on local SQLite and local storage.
# - As soon as you add your keys below, Firebase Authentication, Cloud Firestore,
#   and Cloud Storage activate immediately with ZERO code changes!
# ==============================================================================

# Flask Server Secret Key (Generate a random string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Optional GitHub Token (for cloud builds if configured)
GITHUB_TOKEN=

# ==============================================================================
# 1. FIREBASE CLIENT CONFIGURATION (Web App)
# ==============================================================================
# Where to find these in Firebase Console:
# 1. Go to https://console.firebase.google.com
# 2. Open your Project -> Click the Gear Icon ⚙️ (Project Settings) -> General tab
# 3. Scroll down to "Your apps" -> Select/Add your Web App (</>)
# 4. Copy the values from the `firebaseConfig` object:

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ==============================================================================
# 2. FIREBASE ADMIN SDK CREDENTIALS (Backend Server)
# ==============================================================================
# Where to get your service account key in Firebase Console:
# 1. Project Settings ⚙️ -> "Service accounts" tab
# 2. Click "Generate new private key" -> Click "Generate key"
# 3. A JSON file will download (e.g. `your-project-firebase-adminsdk-xxxxx.json`)
#
# CHOOSE ONE OF THE FOLLOWING OPTIONS:
#
# OPTION A (Recommended for Local Dev):
# Rename the downloaded JSON file to `serviceAccount.json` and place it in the
# root folder of this project (same folder as app.py):
GOOGLE_APPLICATION_CREDENTIALS=serviceAccount.json

# OPTION B (Alternative file path):
# FIREBASE_SERVICE_ACCOUNT_PATH=path/to/your-serviceAccount.json

# OPTION C (Recommended for Cloud Hosting like Render, Railway, Heroku):
# Paste the entire content of the downloaded JSON file as a single-line string:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'

# ==============================================================================
# 3. FIREBASE CONSOLE CHECKLIST
# ==============================================================================
# To ensure all Firebase features work smoothly:
#
# [✓] AUTHENTICATION:
#     - In Firebase Console, go to "Authentication" -> "Get Started"
#     - Under "Sign-in method" tab:
#       * Enable "Email/Password"
#       * Enable "Google" (enter your support email and click Save)
#     - Under "Settings" tab -> "Authorized domains":
#       * Ensure `localhost` is listed (it is added by default)
#       * Add your production custom domain if hosted online
#
# [✓] CLOUD FIRESTORE:
#     - In Firebase Console, go to "Firestore Database" -> "Create database"
#     - Choose your database location (e.g., us-central1 or europe-west1)
#     - Start in "Test mode" for development, or configure security rules
#
# [✓] CLOUD STORAGE:
#     - In Firebase Console, go to "Storage" -> "Get Started"
#     - Follow the prompt to create the default storage bucket
#     - Copy your bucket name (e.g. `your-project.appspot.com` or `your-project.firebasestorage.app`)
#       and set it as FIREBASE_STORAGE_BUCKET above.
# ==============================================================================
